# 视觉模型配置
LVM_API_KEY=your_api_key_here
LVM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LVM_MODEL 可选；不配置时传 default 给网关
# LVM_MODEL=glm-4v-flash

# Langfuse 可观测（可选，不填则不上报 trace）
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true

# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true
# Leader LangGraph 节点级调试日志（可选）
# LEADER_GRAPH_TRACE=true

# DB + RAG 数据目录（可选，默认 backend/data；SQLite 与 Chroma 存于此）
# LANGUAGE_AGENT_DATA_DIR=./data
